# Vercel / Production environment variables
# This file is safe to commit — it contains no secrets, only the public API URL.
# In Next.js, variables prefixed with NEXT_PUBLIC_ are embedded at build time
# and available in the browser.

# ── Backend API ────────────────────────────────────────────────────────────
# Point this to your deployed Render backend URL.
NEXT_PUBLIC_API_URL=https://crm-backend-fxxp.onrender.com
